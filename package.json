{
  "name": "dangulea-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-news.mjs && vite",
    "news:sync": "node scripts/prepare-news.mjs --sync",
    "news:factcheck": "node scripts/news-factcheck.mjs",
    "news:factcheck:draft": "node scripts/news-factcheck.mjs --draft",
    "build": "node scripts/prepare-news.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/generate-news-feed.mjs && python3 scripts/render-news-images.py && python3 scripts/validate-news.py",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs && python3 -m unittest discover -s scripts -p '*_test.py'",
    "validate:news": "python3 scripts/validate-news.py",
    "verify:live": "python3 scripts/validate-news.py --base-url https://dangulea.at",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist",
    "test:feed": "node --test scripts/generate-news-feed.test.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "^1.13.6"
    }
  }
}
